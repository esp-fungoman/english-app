{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/web/src",
    "targets": {
      "dev": {
        "command": "next dev --port 3000",
        "options": {
          "cwd": "apps/web"
        }
      },
      "start": {
        "command": "next start --port 3000",
        "options": {
          "cwd": "apps/web"
        }
      }
    }
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
