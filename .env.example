DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=
STUDENT_SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
PORT=3333
NEXT_PUBLIC_API_URL=http://localhost:3333
# Optional frontend proxy target. When set, point NEXT_PUBLIC_API_URL to the
# frontend's own public origin so browser API requests stay on that origin.
API_UPSTREAM_URL=

# Railway / S3-compatible image storage (API only)
# Keep all R2_* values empty when using this provider.
BUCKET_NAME=
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_FORCE_PATH_STYLE=false

# Alternative: Cloudflare R2 (API only)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: use the exact S3 API endpoint for jurisdiction-restricted buckets.
# Default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Security: generate independent random secrets (>=32 characters) for production.
RATE_LIMIT_SECRET=
REDIS_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password. Container API: use redis:6379.
REDIS_URL=redis://:replace-with-a-long-random-password@127.0.0.1:6379
# Explicit trusted reverse proxy IPs/CIDRs only; blank means trust none.
TRUSTED_PROXIES=
# Counts per fixed window; windows documented in docs/SECURITY.md.
RATE_LIMIT_LOGIN_PAIR=10
RATE_LIMIT_LOGIN_IP=300
RATE_LIMIT_REGISTER_HOUR=30
RATE_LIMIT_REGISTER_DAY=100
RATE_LIMIT_UPLOAD_STUDENT=10
RATE_LIMIT_UPLOAD_ADMIN=120
RATE_LIMIT_IMPORT=5
RATE_LIMIT_USER=300
RATE_LIMIT_MEDIA=600
RATE_LIMIT_IP=3000
